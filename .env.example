# انسخ هذا الملف إلى ‎.env واملأ القيم. ملف ‎.env لا يُرفع إلى git أبدًا.

# رابط الاتصال بـ MongoDB (محلي أو Atlas)
MONGODB_URL=mongodb://localhost:27017

# اسم قاعدة البيانات. بدونه يستخدم Mongo قاعدة اسمها "test".
MONGODB_DB=attendance

PORT=3000

# سرّ توقيع الـ JWT: نص عشوائي طويل. من يعرفه يستطيع تزوير أي توكن.
# ولّده بالأمر: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# المنطقة الزمنية التي يُحسب بها "يوم العمل"
APP_TIMEZONE=Asia/Damascus

# حساب المدير الأول: يُنشأ تلقائيًا عند أول إقلاع إن لم يوجد أي مدير.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
